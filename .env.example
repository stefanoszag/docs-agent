# ── Required ──────────────────────────────────────────────────────────────────
DB_URL=postgresql+psycopg2://docsagent:docsagent@localhost:5432/docsagent

# ── LLM provider ──────────────────────────────────────────────────────────────
# Options: ollama | anthropic | openai  (default: ollama)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b

# Required only when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://192.168.x.x:11434

# Required only when LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Required only when LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# ── Embedding provider ────────────────────────────────────────────────────────
# Options: ollama | openai  (default: ollama)
# If you change this you must re-run ingest.py — vectors are tied to the model.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# ── Retrieval & agent config ──────────────────────────────────────────────────
COLLECTION_NAME=docs
RETRIEVER_K=4
# Cosine distance cutoff — lower = stricter (requires a closer match to proceed)
CONFIDENCE_THRESHOLD=0.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Number of messages (= 3 Q&A turns) passed as conversation history to prompts
HISTORY_WINDOW=6

# ── LangSmith observability (optional) ───────────────────────────────────────
# Remove this block to disable all tracing — no code changes required.
# LANGSMITH_TRACING_V2=true
# LANGSMITH_API_KEY=ls__...
# LANGSMITH_PROJECT=docs-agent
